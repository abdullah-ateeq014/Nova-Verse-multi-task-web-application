/* 3D-style canvas racer: perspective road, traffic, nitro, score */
let racer={running:false,x:500,speed:0,score:0,lane:1,keys:{},cars:[],raf:0,last:0};
function startNovaRacer(){showPage('3dracer');const c=$('racerCanvas');if(!c)return;stopNovaRacer();racer={running:true,x:500,speed:7,score:0,lane:1,keys:{},cars:[],raf:0,last:performance.now()};for(let i=0;i<5;i++)racer.cars.push({lane:Math.floor(Math.random()*3),z:Math.random()*1.2+0.15});window.addEventListener('keydown',racerKey);window.addEventListener('keyup',racerKey);racer.raf=requestAnimationFrame(racerLoop);$('racerInfo').textContent='🏁 Race started — ← → steer • ↑ boost • ↓ brake • P pause';addXP(5,'Started Nova 3D Racer');}
function stopNovaRacer(){if(racer.raf)cancelAnimationFrame(racer.raf);racer.running=false;window.removeEventListener('keydown',racerKey);window.removeEventListener('keyup',racerKey);}
function racerKey(e){if(['ArrowLeft','ArrowRight','ArrowUp','ArrowDown','KeyP'].includes(e.code))e.preventDefault();racer.keys[e.code]=e.type==='keydown';if(e.type==='keydown'&&e.code==='KeyP')racer.running=!racer.running;if(racer.running&&!racer.raf)racer.raf=requestAnimationFrame(racerLoop)}
function racerLoop(t){if(!racer.running){racer.raf=0;return}const c=$('racerCanvas'),ctx=c.getContext('2d'),dt=Math.min(.035,(t-racer.last)/1000||.016);racer.last=t;const boost=racer.keys.ArrowUp?1.5:1;const brake=racer.keys.ArrowDown?.55:1;racer.speed=Math.max(2,Math.min(18,racer.speed*0.985+8*boost*brake*dt));if(racer.keys.ArrowLeft)racer.x-=380*dt;if(racer.keys.ArrowRight)racer.x+=380*dt;racer.x=Math.max(315,Math.min(685,racer.x));racer.score+=racer.speed*dt;ctx.clearRect(0,0,c.width,c.height);drawRacer(ctx,c.width,c.height,t);racer.cars.forEach(car=>{car.z+=racer.speed*dt*.13;if(car.z>1.2){car.z=.08;car.lane=Math.floor(Math.random()*3);racer.score+=50}const cx=330+car.lane*170,py=150+car.z*430,scale=.25+car.z*.85;const cw=42*scale,ch=72*scale;ctx.fillStyle='#f43f5e';ctx.fillRect(cx-cw/2,py-ch/2,cw,ch);});const playerLane=Math.round((racer.x-315)/185);racer.cars.forEach(car=>{if(car.lane===playerLane&&car.z>.88&&car.z<1.06){stopNovaRacer();toast('💥 Crash! Score '+Math.floor(racer.score));addXP(Math.floor(racer.score/50),'Racer score');}});ctx.fillStyle='#60a5fa';ctx.fillRect(racer.x-24,520,48,82);ctx.fillStyle='#111827';ctx.fillRect(racer.x-17,535,34,22);ctx.fillRect(racer.x-17,574,34,22);ctx.fillStyle='#fff';ctx.font='bold 20px sans-serif';ctx.fillText('SCORE '+Math.floor(racer.score),25,35);ctx.fillText('SPEED '+Math.floor(racer.speed),25,62);racer.raf=requestAnimationFrame(racerLoop)}
function drawRacer(ctx,w,h,t){const g=ctx.createLinearGradient(0,0,0,h);g.addColorStop(0,'#08111f');g.addColorStop(1,'#03050b');ctx.fillStyle=g;ctx.fillRect(0,0,w,h);ctx.fillStyle='#0b3b2a';ctx.fillRect(0,120,270,h-120);ctx.fillRect(730,120,270,h-120);ctx.fillStyle='#242936';ctx.beginPath();ctx.moveTo(430,120);ctx.lineTo(570,120);ctx.lineTo(900,h);ctx.lineTo(100,h);ctx.closePath();ctx.fill();ctx.strokeStyle='#f8fafc';ctx.lineWidth=5;ctx.setLineDash([30,35]);ctx.lineDashOffset=-(t/8);ctx.beginPath();ctx.moveTo(500,120);ctx.lineTo(500,h);ctx.stroke();ctx.setLineDash([]);ctx.strokeStyle='#fbbf24';ctx.lineWidth=8;ctx.beginPath();ctx.moveTo(430,120);ctx.lineTo(100,h);ctx.moveTo(570,120);ctx.lineTo(900,h);ctx.stroke();}


