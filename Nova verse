<style>
  /* =========================================
   NOVA VERSE PREMIUM OPENING SCREEN
   ========================================= */

#novaStartup {
  position: fixed;
  inset: 0;
  z-index: 99999999;

  display: flex;
  align-items: center;
  justify-content: center;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 50% 42%,
      rgba(92, 76, 255, .20),
      transparent 22%
    ),
    radial-gradient(
      circle at 15% 15%,
      rgba(0, 212, 255, .12),
      transparent 28%
    ),
    radial-gradient(
      circle at 85% 82%,
      rgba(124, 92, 255, .13),
      transparent 30%
    ),
    #02050d;

  transition:
    opacity .8s ease,
    visibility .8s ease;
}

#novaStartup.hide {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}


/* STARS */

.nova-stars {
  position: absolute;
  inset: 0;

  opacity: .75;

  background-image:
    radial-gradient(
      circle,
      rgba(255,255,255,.9) 0 1px,
      transparent 1.5px
    ),
    radial-gradient(
      circle,
      rgba(103,232,249,.7) 0 1px,
      transparent 1.5px
    );

  background-size:
    110px 110px,
    170px 170px;

  background-position:
    15px 25px,
    70px 90px;

  animation:
    novaStarsMove 12s linear infinite;
}


/* GLOW ORBS */

.nova-orb {
  position: absolute;

  border-radius: 50%;

  pointer-events: none;
}

.nova-orb-1 {
  width: 430px;
  height: 430px;

  top: -250px;
  left: -180px;

  background:
    radial-gradient(
      circle,
      rgba(124,92,255,.25),
      transparent 68%
    );

  animation:
    novaFloat 5s ease-in-out infinite;
}

.nova-orb-2 {
  width: 470px;
  height: 470px;

  right: -230px;
  bottom: -270px;

  background:
    radial-gradient(
      circle,
      rgba(0,212,255,.18),
      transparent 68%
    );

  animation:
    novaFloat 6s ease-in-out infinite reverse;
}


/* CONTENT */

.nova-start-content {
  position: relative;

  z-index: 2;

  width: min(92vw, 650px);

  text-align: center;

  animation:
    novaStartIn .9s
    cubic-bezier(.2,.8,.2,1)
    both;
}


/* LOGO */

.nova-start-logo {
  width: 142px;
  height: 142px;

  margin: 0 auto 25px;

  padding: 8px;

  border-radius: 40px;

  display: grid;
  place-items: center;

  background:
    linear-gradient(
      145deg,
      rgba(124,92,255,.95),
      rgba(0,170,210,.9)
    );

  border:
    1px solid rgba(255,255,255,.25);

  box-shadow:
    0 0 35px rgba(124,92,255,.45),
    0 0 110px rgba(0,212,255,.16),
    inset 0 1px 0 rgba(255,255,255,.35);

  animation:
    novaLogoPulse 2.1s
    ease-in-out infinite;
}

.nova-start-logo svg {
  width: 100%;
  height: 100%;

  display: block;

  filter:
    drop-shadow(
      0 0 12px
      rgba(103,232,249,.65)
    );
}


/* TITLE */

.nova-start-title {
  font-size: clamp(42px, 7vw, 76px);

  line-height: 1;

  font-weight: 1000;

  letter-spacing: -3px;

  color: white;

  text-shadow:
    0 5px 30px
    rgba(0,0,0,.4);
}

.nova-start-title span {
  background:
    linear-gradient(
      90deg,
      #fff,
      #67e8f9,
      #a78bfa
    );

  -webkit-background-clip: text;
  background-clip: text;

  color: transparent;
}


/* SUBTITLE */

.nova-start-sub {
  margin-top: 13px;

  color: #9fb4d7;

  font-size: 13px;

  letter-spacing: 4px;

  font-weight: 700;
}


/* LINE */

.nova-start-line {
  width: min(330px, 65vw);

  height: 1px;

  margin: 25px auto 0;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(103,232,249,.6),
      transparent
    );
}


/* LOADING BAR */

.nova-start-loading {
  width: min(270px, 65vw);

  height: 5px;

  margin: 20px auto 0;

  overflow: hidden;

  border-radius: 99px;

  background:
    rgba(255,255,255,.08);

  border:
    1px solid rgba(255,255,255,.06);
}

.nova-start-loading i {
  display: block;

  width: 45%;
  height: 100%;

  border-radius: 99px;

  background:
    linear-gradient(
      90deg,
      #7c5cff,
      #19cfff,
      #fff
    );

  box-shadow:
    0 0 14px
    rgba(25,207,255,.65);

  animation:
    novaLoading 1.55s
    ease-in-out infinite;
}


/* STATUS */

.nova-start-status {
  margin-top: 13px;

  color: #7188ae;

  font-size: 12px;

  letter-spacing: 1px;

  animation:
    novaStatus 1.4s
    ease-in-out infinite;
}


/* CREDIT */

.nova-start-credit {
  margin-top: 32px;

  color: #53698e;

  font-size: 12px;
}

.nova-start-credit b {
  color: #9bb2d8;
}


/* ANIMATIONS */

@keyframes novaStartIn {

  from {
    opacity: 0;
    transform:
      translateY(24px)
      scale(.96);
  }

  to {
    opacity: 1;
    transform: none;
  }

}


@keyframes novaLogoPulse {

  0%,100% {

    transform:
      translateY(0)
      scale(1);

    box-shadow:
      0 0 35px rgba(124,92,255,.45),
      0 0 110px rgba(0,212,255,.16),
      inset 0 1px 0 rgba(255,255,255,.35);
  }

  50% {

    transform:
      translateY(-5px)
      scale(1.035);

    box-shadow:
      0 0 50px rgba(124,92,255,.62),
      0 0 140px rgba(0,212,255,.22),
      inset 0 1px 0 rgba(255,255,255,.42);
  }

}


@keyframes novaLoading {

  0% {
    transform: translateX(-125%);
  }

  55% {
    transform: translateX(95%);
  }

  100% {
    transform: translateX(245%);
  }

}


@keyframes novaStatus {

  50% {
    opacity: .55;
  }

}


@keyframes novaStarsMove {

  to {
    background-position:
      125px 135px,
      10px 20px;
  }

}


@keyframes novaFloat {

  50% {
    transform:
      translate(20px,15px)
      scale(1.08);
  }

}


/* MOBILE */

@media(max-width:520px) {

  .nova-start-logo {
    width: 112px;
    height: 112px;
    border-radius: 32px;
  }

  .nova-start-title {
    letter-spacing: -2px;
  }

  .nova-start-sub {
    font-size: 10px;
    letter-spacing: 2.5px;
  }

}
