<script>
/* ===== NOVA VERSE COMPETITION JUDGE MODE ===== */
let judgeTimerId=null, judgeSeconds=90, judgeRunning=false;
const judgeSteps=[
  ['nova','Nova AI'],['search','Web Search'],['education','Nova Academy'],
  ['health','Health Lab'],['games','Nova Arcade'],['workspace','Workspace']
];

function openJudgeMode(){
  const m=document.getElementById('novaJudgeModal');
  if(m){m.classList.add('show');updateJudgeUI();}
}
function closeJudgeMode(){
  const m=document.getElementById('novaJudgeModal');
  if(m)m.classList.remove('show');
  stopJudgeDemo();
}
function updateJudgeUI(){
  const t=document.getElementById('judgeTimer'),p=document.getElementById('judgeProgress');
  if(t)t.textContent=judgeSeconds;
  if(p)p.style.width=((90-judgeSeconds)/90*100)+'%';
}
function stopJudgeDemo(){
  judgeRunning=false;
  clearInterval(judgeTimerId); judgeTimerId=null;
}
function startJudgeDemo(){
  stopJudgeDemo(); judgeRunning=true; judgeSeconds=90; updateJudgeUI();
  const status=document.getElementById('judgeStatus');
  let step=0;
  status.innerHTML='🚀 Demo started. Nova will guide the presentation automatically.';
  const runStep=()=>{
    if(!judgeRunning)return;
    const [page,name]=judgeSteps[step];
    status.innerHTML='▶ <b>Now showing:</b> '+name+' <span style="color:var(--muted)">— step '+(step+1)+' of '+judgeSteps.length+'</span>';
    if(typeof showPage==='function')showPage(page);
    step=(step+1)%judgeSteps.length;
  };
  runStep();
  judgeTimerId=setInterval(()=>{
    judgeSeconds--; updateJudgeUI();
    if(judgeSeconds<=0){
      stopJudgeDemo();
      status.innerHTML='🏁 <b>Demo complete.</b> Nova Verse presentation finished — you can continue exploring manually.';
      judgeSeconds=90; updateJudgeUI();
      if(typeof toast==='function')toast('🏁 Competition demo complete!');
      return;
    }
    if(judgeSeconds<90 && (90-judgeSeconds)%15===0)runStep();
  },1000);
}
function judgeOpen(page,name){
  stopJudgeDemo();
  closeJudgeMode();
  if(typeof showPage==='function')showPage(page);
  if(typeof toast==='function')toast('🏆 Judge view: '+name);
}
document.addEventListener('keydown',function(e){
  if(e.key==='Escape')closeJudgeMode();
  if((e.ctrlKey||e.metaKey)&&e.key.toLowerCase()==='j'){
    e.preventDefault();openJudgeMode();
  }
});
</script>

