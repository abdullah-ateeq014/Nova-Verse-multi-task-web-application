<script>
/* =========================
   NOVA VERSE SINGLE-FILE EMAIL
   EmailJS is used so this HTML file can send mail without opening Gmail.
   Create an EmailJS service + template, then replace the 3 values below.
   ========================= */
const NOVA_EMAILJS_PUBLIC_KEY = '9SmFhvIZwXwa7z69W';
const NOVA_EMAILJS_SERVICE_ID = 'service_p0y37bl';
const NOVA_EMAILJS_TEMPLATE_ID = 'template_zod25ab';
const NOVA_OWNER_EMAIL = 'ateeqabdullah014@gmail.com';

if(window.emailjs && NOVA_EMAILJS_PUBLIC_KEY !== 'YOUR_EMAILJS_PUBLIC_KEY'){
  emailjs.init({publicKey:NOVA_EMAILJS_PUBLIC_KEY});
}

async function sendOwnerMessage(event){
  event.preventDefault();

  const name=document.getElementById('ownerContactName').value.trim();
  const email=document.getElementById('ownerContactEmail').value.trim();
  const message=document.getElementById('ownerContactMessage').value.trim();
  const status=document.getElementById('ownerContactStatus');
  const button=document.getElementById('ownerSendButton');

  if(!name||!email||!message){
    status.innerHTML='⚠️ Please fill in your name, email and message.';
    status.style.color='var(--danger)';
    return false;
  }

  if(NOVA_EMAILJS_PUBLIC_KEY==='YOUR_EMAILJS_PUBLIC_KEY' ||
     NOVA_EMAILJS_SERVICE_ID==='YOUR_EMAILJS_SERVICE_ID' ||
     NOVA_EMAILJS_TEMPLATE_ID==='YOUR_EMAILJS_TEMPLATE_ID'){
    status.innerHTML='⚙️ Email is almost ready. Add your EmailJS Public Key, Service ID and Template ID in the code.';
    status.style.color='var(--danger)';
    return false;
  }

  button.disabled=true;
  button.style.opacity='.7';
  button.innerHTML='⏳ Sending...';
  status.innerHTML='📨 Sending your message to <b>'+NOVA_OWNER_EMAIL+'</b>…';
  status.style.color='var(--muted)';

  try{
    const templateParams={
      name:name,
      email:email,
      message:message,
      to_email:NOVA_OWNER_EMAIL,
      reply_to:email,
      subject:'Nova Verse Contact Message from '+name
    };

    const result=await emailjs.send(
      NOVA_EMAILJS_SERVICE_ID,
      NOVA_EMAILJS_TEMPLATE_ID,
      templateParams
    );

    if(result && result.status===200){
      status.innerHTML='✅ <b>Your message was sent successfully!</b> Abdullah will receive it at <b>'+NOVA_OWNER_EMAIL+'</b>.';
      status.style.color='var(--good)';
      document.getElementById('ownerContactName').value='';
      document.getElementById('ownerContactEmail').value='';
      document.getElementById('ownerContactMessage').value='';
      if(typeof toast==='function') toast('✅ Message sent to Abdullah!');
    }else{
      throw new Error('Email service did not accept the message.');
    }
  }catch(error){
    console.error('Nova Verse email error:',error);
    status.innerHTML='❌ The message was not sent. Check your EmailJS Service ID, Template ID and Public Key.';
    status.style.color='var(--danger)';
    if(typeof toast==='function') toast('❌ Message not sent');
  }finally{
    button.disabled=false;
    button.style.opacity='1';
    button.innerHTML='📩 Send Message';
  }

  return false;
}
</script>

