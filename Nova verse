function sendContactUs(event){
  event.preventDefault();
  const form=event.currentTarget;
  const name=document.getElementById('contactName').value.trim();
  const email=document.getElementById('contactEmail').value.trim();
  const message=document.getElementById('contactMessage').value.trim();
  const status=document.getElementById('contactStatus');
  const button=document.getElementById('contactSendButton');

  if(!name||!email||!message){
    status.textContent='⚠️ Please fill in all fields.';
    status.style.color='var(--danger)';
    return false;
  }

  button.disabled=true;
  button.style.opacity='.7';
  button.textContent='⏳ Sending...';
  status.innerHTML='📨 Sending your message to <b>ateeqabdullah@gmail.com</b>…';
  status.style.color='var(--muted)';

  form.querySelector('[name="_subject"]').value='Nova Verse Contact Us message from '+name;
  let reply=form.querySelector('[name="_replyto"]');
  if(!reply){
    reply=document.createElement('input');
    reply.type='hidden'; reply.name='_replyto'; form.appendChild(reply);
  }
  reply.value=email;

  try{
    /* Native POST + hidden iframe works even when AJAX/fetch is blocked by CORS. */
    form.submit();
    setTimeout(function(){
      status.innerHTML='✅ <b>Your message was submitted!</b> It was sent to <b>ateeqabdullah@gmail.com</b> through the email service.';
      status.style.color='var(--good)';
      form.reset();
      toast('✅ Message submitted!');
      button.disabled=false;
      button.style.opacity='1';
      button.textContent='📩 Send Message';
    },1200);
  }catch(error){
    status.innerHTML='❌ Could not submit the message. Please try again.';
    status.style.color='var(--danger)';
    button.disabled=false;
    button.style.opacity='1';
    button.textContent='📩 Send Message';
    toast('Message could not be submitted');
  }
  return false;
}

